# ESP-IDF (v5.x) security configuration used for the ESP32-S3 metering node.
# Append to the project's sdkconfig.defaults before the first build.

# --- Secure Boot V2 (RSA-3072 signed bootloader and application) ---
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_BOOT_SIGNING_KEY="secure_boot_signing_key.pem"

# --- Flash encryption (XTS-AES-128) ---
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_AES128=y
# Development mode allows re-flashing over UART; use RELEASE for production.
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT=y
# CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y

# --- Production hardening (not exercised in the pilot) ---
# CONFIG_SECURE_BOOT_ALLOW_JTAG is NOT set  -> JTAG disabled by bootloader
# CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=y
# CONFIG_BOOTLOADER_APP_SECURE_VERSION=1
